<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LaunchAgent, not LaunchDaemon (plan 5.5): must run in the
	     installing user's own session to see their device selection
	     and receive microphone TCC access. -->
	<key>Label</key>
	<string>cat.sysop.aiheadset</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/AIHeadset.app/Contents/MacOS/AIHeadset</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
