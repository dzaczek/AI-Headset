# Wzorzec konfiguracji podpisywania i notaryzacji.
# Skopiuj do packaging/.env i uzupełnij własnymi wartościami.
# packaging/.env jest w .gitignore i NIGDY nie trafia do repozytorium.

# Apple ID (adres e-mail konta developerskiego)
AIHEADSET_APPLE_ID="ty@example.com"

# Team ID -- znajdziesz w developer.apple.com → Membership
AIHEADSET_TEAM_ID="XXXXXXXXXX"

# Dokładna nazwa certyfikatu z Keychaina.
# Sprawdź: security find-identity -v -p codesigning
AIHEADSET_SIGN_IDENTITY="Developer ID Application: Twoje Imię (XXXXXXXXXX)"

# Potrzebny tylko do make_pkg.sh (instalator .pkg)
AIHEADSET_INSTALLER_IDENTITY="Developer ID Installer: Twoje Imię (XXXXXXXXXX)"

# Hasło aplikacji z appleid.apple.com → Sign-In and Security →
# App-Specific Passwords. Używane do notaryzacji bez terminala.
SUPERSEC="xxxx-xxxx-xxxx-xxxx"
